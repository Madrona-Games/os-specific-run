{
  "name": "os-specific-run",
  "version": "3.0.0",
  "description": "A github action for running a separate command based on the os",
  "scripts": {
    "prepare": "lefthook install",
    "build": "npm install && tsc --noEmit && node esbuild.config.mjs",
    "lint": "eslint **/*.ts --cache",
    "format": "prettier --write **/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Madrona-Games/os-specific-run.git"
  },
  "keywords": [],
  "author": "Madrona Games Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Madrona-Games/os-specific-run/issues"
  },
  "homepage": "https://github.com/Madrona-Games/os-specific-run#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.15.0"
  }
}
